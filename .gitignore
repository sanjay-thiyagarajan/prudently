# Secrets & credentials
.env
.env.local
service-account*.json
*.pem
*.key

# Terraform
*.tfstate
*.tfstate.backup
*.tfvars
!infra/terraform/envs/dev/terraform.tfvars.example
.terraform/
# .terraform.lock.hcl is intentionally NOT ignored — committed for reproducible provider versions

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ADK deploy temp artifacts (adk deploy agent_engine creates these transiently)
apps/api/agents/*_tmp*/
apps/api/agents/*/.adk/

# Node / Next.js
node_modules/
.next/
out/
apps/web/.env*.local

# OS / editor
.DS_Store
.idea/
.vscode/

# Misc
*.log
dist/
build/
.local_output/

# Next.js/TypeScript incremental build cache — machine-local, never committed.
tsconfig.tsbuildinfo
*.tsbuildinfo
