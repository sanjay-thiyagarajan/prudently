# GCP project, dedicated to this hackathon. Region is locked to us-central1 across every
# GCP product this project uses (Cloud Run, Reasoning Engine, Firestore, Memory Bank,
# Model Armor) — do not change post-provisioning, Firestore's location is immutable.
GOOGLE_CLOUD_PROJECT=prudently-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
MEMORY_BANK_LOCATION=us-central1

# Gemini via the direct Gemini API (not Vertex publisher-model auth). GEMINI_API_KEY is read
# from Secret Manager (secret: prudently-gemini-api-key) at runtime, never committed.
GOOGLE_GENAI_USE_ENTERPRISE=false
MODEL_REASONING=gemini-3.5-flash
MODEL_FAST=gemini-3.5-flash
GEMINI_API_KEY_SECRET=prudently-gemini-api-key

# Platform capability adapter backends: vertex | local — see docs/day1-probe-results.md for
# which capabilities have a real GCP product behind them vs. a local-emulated fallback.
REGISTRY_BACKEND=local
IDENTITY_BACKEND=local
GATEWAY_BACKEND=local
ARMOR_BACKEND=vertex
OBSERVABILITY_BACKEND=vertex

# Reasoning Engine resource IDs, set after each agent's `adk deploy agent_engine`. Memory Bank
# needs these since memories are a sub-resource of a specific deployed engine.
SHIFT_AGENT_ENGINE_ID=6191105334669475840
INVENTORY_AGENT_ENGINE_ID=6199971796435861504
SUPPLY_AGENT_ENGINE_ID=6129884527234908160
HR_AGENT_ENGINE_ID=5467010957081313280
MEDREP_AGENT_ENGINE_ID=6319035711584468992
CHAOS_AGENT_ENGINE_ID=2682941962436214784
COORDINATOR_AGENT_ENGINE_ID=6956858008810815488

# Model Armor template — regional, must match the region lock above.
MODEL_ARMOR_LOCATION=us-central1
MODEL_ARMOR_TEMPLATE_ID=prudently-vendor-ingest

# Manager approval workflow (Gmail SMTP + app password from Secret Manager, not OAuth — see
# AGENTS.md's Gmail setup section for the one manual prerequisite).
EMAIL_BACKEND=gmail
MANAGER_EMAIL=you@example.com
GMAIL_SENDER_EMAIL=you@example.com
GMAIL_APP_PASSWORD_SECRET=prudently-gmail-app-password

# Polls the same mailbox over IMAP (same app password above) for genuine incoming vendor mail
# and screens it through Medical Representative's real Model Armor path — see
# services/platform/vendor_inbox.py's module docstring. Off by default, unlike every backend
# above: this is a brand-new integration with a real personal mailbox. Set to "imap" only after
# confirming IMAP access is enabled on the account (Gmail Settings → Forwarding and POP/IMAP →
# Enable IMAP — a per-account toggle this app cannot set for you).
VENDOR_INBOX_BACKEND=local

# Simulation clock
SIM_SEED=42
SIM_SPEEDUP=1440
DRY_RUN=true

# Local dev / emulators
FIRESTORE_EMULATOR_HOST=localhost:8080
PUBSUB_EMULATOR_HOST=localhost:8085

# API <-> web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
