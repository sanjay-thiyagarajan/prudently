# GCP project (created Day 1, dedicated to this hackathon)
GOOGLE_CLOUD_PROJECT=prudently-hackathon
GOOGLE_CLOUD_LOCATION=us-central1
MEMORY_BANK_LOCATION=us

# Gemini — via the direct Gemini API (not Vertex publisher-model auth), per verified
# round-trip against gemini-3.5-flash. GEMINI_API_KEY is read from Secret Manager
# (secret: prudently-gemini-api-key) at runtime, never committed. No gemini-3.5-pro
# exists yet (confirmed 404 in every tested location as of the Day-1 probe) — both
# tiers use the same model for now.
# NOTE: ADK 2.7.1 renamed GOOGLE_GENAI_USE_VERTEXAI -> GOOGLE_GENAI_USE_ENTERPRISE (the old
# name still works but logs a deprecation warning) — verified by reading env_utils.py in the
# installed package rather than assumed, since this API surface moves fast. Confirm again if
# `uv add`/`uv sync` ever bumps google-adk to a new minor/major version.
GOOGLE_GENAI_USE_ENTERPRISE=false
MODEL_REASONING=gemini-3.5-flash
MODEL_FAST=gemini-3.5-flash
GEMINI_API_KEY_SECRET=prudently-gemini-api-key

# Platform capability adapter backends: vertex | local
# Set per the Day-1 probe results — see docs/day1-probe-results.md
# Reasoning Engine resource IDs — filled in after each agent's first `adk deploy
# agent_engine` (see docs/build-plan.md Day 3-5). Memory Bank needs these since memories
# are a sub-resource of a specific deployed engine.
SHIFT_AGENT_ENGINE_ID=6191105334669475840
INVENTORY_AGENT_ENGINE_ID=6199971796435861504
SUPPLY_AGENT_ENGINE_ID=6129884527234908160
HR_AGENT_ENGINE_ID=5467010957081313280
CHAOS_AGENT_ENGINE_ID=
COORDINATOR_AGENT_ENGINE_ID=

REGISTRY_BACKEND=local
IDENTITY_BACKEND=local
GATEWAY_BACKEND=local
ARMOR_BACKEND=vertex
OBSERVABILITY_BACKEND=local

# Simulation clock
SIM_SEED=42
SIM_SPEEDUP=1440
DRY_RUN=true

# Local dev / emulators
FIRESTORE_EMULATOR_HOST=localhost:8080
PUBSUB_EMULATOR_HOST=localhost:8085

# API <-> web
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
